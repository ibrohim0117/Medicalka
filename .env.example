# Medicalka Social — muhit o'zgaruvchilari namunasi
#
# Nusxa oling:  cp .env.example .env
# `.env` git'ga tushmaydi, `.env.example` esa tushadi.
#
# DIQQAT: qiymat yonida izoh yozmang. `docker compose` `env_file` da
# satr oxiridagi `# izoh` ni qiymatning bir qismi deb qabul qiladi.
#
# Bu yerdagi nomlar `app/core/config.py` dagi `Settings` maydonlari bilan
# bir xil bo'lishi shart.

# Ilova
APP_NAME="Medicalka Social"
# development | staging | production | test
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Ma'lumotlar bazasi
# FastAPI async driver bilan ishlaydi.
DATABASE_URL=postgresql+asyncpg://medicalka:medicalka@localhost:5432/medicalka

# Celery va Alembic sinxron driver talab qiladi. Berilmasa yuqoridagi
# qatordan avtomatik hosil qilinadi (asyncpg -> psycopg2), shuning uchun
# odatda buni yozish shart emas.
# SYNC_DATABASE_URL=postgresql+psycopg2://medicalka:medicalka@localhost:5432/medicalka

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT
# Quyidagi qiymat faqat mahalliy ishlab chiqish uchun: u 32 belgidan uzun,
# shuning uchun `cp .env.example .env` dan keyin loyiha darhol ko'tariladi.
# ENVIRONMENT=production bo'lsa ilova bu qiymatni rad etadi.
# Haqiqiy kalit yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-uchun-vaqtinchalik-kalit-almashtiring
JWT_ALGORITHM=HS256

# Admin ruchkalari uchun umumiy sir (X-Admin-Token sarlavhasi).
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-admin-token-min-16-belgi

# TTL — amal qilish muddatlari
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2
# Tasdiqlash xatini qayta so'rash orasidagi eng kam vaqt (soniyada).
RESEND_VERIFICATION_COOLDOWN_SECONDS=120
# Tasdiqlanmagan hisob shu muddatdan keyin fon vazifasi tomonidan o'chiriladi.
UNVERIFIED_USER_TTL_HOURS=48
# Postlar shu kundan eski bo'lsa fon vazifasi o'chiradi. 0 — o'chirilmaydi.
POST_TTL_DAYS=0

# Redis / Celery
# Har biri alohida baza raqamida — kalitlar aralashib ketmasligi uchun.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
# Vergul bilan ajratilgan ro'yxat. Bo'sh qoldirilsa CORS middleware ulanmaydi.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP — tasdiqlash xatini yuborish uchun.
# SMTP_HOST bo'sh bo'lsa xat yuborilmaydi, havola faqat logga yoziladi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@medicalka.uz
SMTP_STARTTLS=true
# Xatdagi tasdiqlash havolasi shu manzildan quriladi.
PUBLIC_BASE_URL=http://localhost:8000

# Login'ga bruteforce hujumidan himoya
# LOGIN_RATE_WINDOW_SECONDS ichida LOGIN_RATE_LIMIT ta muvaffaqiyatsiz
# urinishdan keyin LOGIN_LOCKOUT_SECONDS ga bloklanadi. 0 — o'chirilgan.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Paginatsiya chegaralari
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Quyidagilarni ilova o'qimaydi — ular faqat docker compose uchun.
# Postgres konteyneri o'zini shular bilan sozlaydi, compose esa
# DATABASE_URL ni shulardan yig'adi.
POSTGRES_USER=medicalka
POSTGRES_PASSWORD=medicalka
POSTGRES_DB=medicalka

# Host mashinada port band bo'lsa, shu yerdan o'zgartiring.
API_PORT=8000
POSTGRES_EXPOSED_PORT=5432
