#  Medicalka Social — muhit o'zgaruvchilari namunasi
#
#  Nusxa oling:  cp .env.example .env
#  `.env` git'ga tushmaydi, `.env.example` esa tushadi.
#
#  DIQQAT: qiymat yonida izoh yozmang. `docker compose` `env_file` da
#  satr oxiridagi `# izoh` ni qiymatning bir qismi deb qabul qiladi.

# Ilova
APP_NAME="Medicalka Social"
# development | staging | production | test
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Xavfsizlik
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Ishlab chiqarishda MAJBURIY almashtiriladi.
SECRET_KEY=change-me-generate-a-long-random-string-before-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Ma'lumotlar bazasi
POSTGRES_USER=medicalka
POSTGRES_PASSWORD=medicalka
POSTGRES_DB=medicalka
# Docker ichida: `db`. Lokal (konteynersiz) ishlaganda: `localhost`.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# To'liq ulanish qatorini qo'lda berish (yuqoridagi POSTGRES_* e'tiborsiz
# qoladi). Odatda kerak emas — testlarda va boshqariladigan bazalarda asqotadi.
# DATABASE_URL=postgresql+asyncpg://user:parol@host:5432/baza

# SQL so'rovlarini logga chiqarish (juda ko'p matn beradi).
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis / Celery
# Har biri alohida baza raqamida — kesishib ketmasligi uchun.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
# Vergul bilan ajratilgan ro'yxat yoki JSON massiv. Bo'sh qoldirilsa
# CORS middleware umuman ulanmaydi.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Paginatsiya chegaralari
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Faqat docker-compose uchun (ilova o'qimaydi)
# Host mashinada band bo'lsa, portlarni shu yerdan o'zgartiring.
API_PORT=8000
POSTGRES_EXPOSED_PORT=5432
